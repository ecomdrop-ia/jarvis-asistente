# ════════════════════════════════════════════════════════════════════════
#   YARBIS — Environment Variables
#   Copy this file to .env and fill in your own keys.
#   NEVER commit .env to git.
# ════════════════════════════════════════════════════════════════════════

# ─── LiveKit Server (audio infrastructure) ─────────────────────────────
# Self-hosted by default — see livekit.yaml. The dev key/secret below
# match the bundled livekit.yaml; keep them as-is for local development.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ─── LLM — OpenAI (the voice brain) ────────────────────────────────────
# Required. Used by the voice-bridge for real-time conversation.
# Get yours at: https://platform.openai.com/api-keys
# Recommended model: gpt-4o-mini (fast + cheap) or gpt-5-mini (reasoning)
OPENAI_API_KEY=sk-proj-...

# ─── LLM — OpenRouter (optional fallback) ──────────────────────────────
# Optional. If you prefer routing through OpenRouter (200+ models,
# Claude/Gemini/etc. with one key). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── LLM — Anthropic (optional, for Hermes Claude routing) ─────────────
# Optional. Only if you want Hermes to use Claude directly instead of
# going through OpenRouter. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── STT — Deepgram (speech-to-text) ───────────────────────────────────
# Required. Recognizes your voice. Free tier covers ~45k minutes.
# Get yours at: https://console.deepgram.com/signup
# Default model: nova-3 (Spanish optimized)
DEEPGRAM_API_KEY=

# ─── TTS — ElevenLabs (text-to-speech) ─────────────────────────────────
# Required. Generates YARBIS's voice. Free tier covers ~10k chars/month.
# Get yours at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID to use. Default is "Cristian" (Colombian Spanish male).
# Browse voices: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=o2vbTbO3g4GrKUg7rehy

# ─── Hermes Gateway (for ask_hermes voice tool) ────────────────────────
# Optional. Only required if you want to use the `ask_hermes` voice tool
# (delegates to Hermes Agent for emails/calendar/notion/etc.).
# Install Hermes via:
#   curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=yarbis-local-secret
HERMES_MODEL=gpt-5-mini
# These are read by Hermes itself, in ~/.hermes/.env:
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=yarbis-local-secret

# ─── Web search — Brave Search (for search_web voice tool) ─────────────
# Optional. Powers the "Yarbis, busca X" voice command.
# Get yours at: https://api.search.brave.com/app/keys (free tier 2000/month)
BRAVE_API_KEY=

# ─── Electron command server ───────────────────────────────────────────
# Internal — port the Electron window control server listens on.
# Voice tools POST here to show/hide/fullscreen the YARBIS window.
YARBIS_CMD_PORT=9871

# ─── Optional integrations (future / Hermes MCPs) ──────────────────────
# These are NOT required for YARBIS to work — they enable specific
# voice commands via Hermes that talk to external services.

# Google OAuth (Gmail + Calendar + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion
NOTION_API_KEY=

# GitHub
GITHUB_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Home Assistant (smart home control)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Picovoice (wake-word "Hey Yarbis" — Phase 3 of roadmap)
PICOVOICE_ACCESS_KEY=
